# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# httpSMS Gateway Configuration (httpsms.com)
# SMS_API_KEY / Httpsms_api_key: Your httpSMS API key from the dashboard settings.
SMS_API_KEY=
Httpsms_api_key=

# DISPATCH_ADMIN_PHONE: Phone number receiving the new booking alerts (+250...).
DISPATCH_ADMIN_PHONE="+250796569416"

# SENDER_PHONE: The registered phone number of your connected Android phone gateway.
SENDER_PHONE="+250796569416"

# Customer Care Email & Inquiries Gateway (Resend)
# Email_api_key: Resend API key used to deliver client messages to Customer Care.
Email_api_key=
# CUSTOMER_CARE_EMAIL: Destination email for customer care messages.
CUSTOMER_CARE_EMAIL="corneliustch@gmail.com"
